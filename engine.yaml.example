# encryption_key: 32-byte AES key used for all at-rest secret encryption.
# Covers: webhook signing secrets in fused_workspace_configs, auth credential
# encryption in Engine-local storage, and connect session state signing.
#
# SECURITY WARNING: this default is publicly known (it's committed to a
# public repo) -- anyone can use it to decrypt secrets encrypted with it.
# Never use it beyond local/throwaway dev. Override in production via the
# FUSED_ENCRYPTION_KEY environment variable.
# Generate a secure key: openssl rand -base64 32
encryption_key: "fused-default-encrypt-key-32b"

# database.url: Postgres connection string for the Engine's data store.
# Override in production via FUSED_DATABASE_URL or DATABASE_URL environment variable.
database:
  url: "postgres://fused:password@localhost:5432/fused?sslmode=disable"
engine:
  # license_key: License key for Registry handshake (authentication and entitlements).
  # Override in production via FUSED_LICENSE_KEY environment variable.
  worker_counts:
    mcp_analytics: 2
    webhook_config: 2
    webhook_analytics: 2

observability:
  otel_target: "localhost:4317"

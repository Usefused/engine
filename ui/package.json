{
  "engines": {
    "node": "^24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "error"
    }
  },
  "name": "fused-ui",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "lint": "eslint app/",
    "test": "node --experimental-strip-types --test app/lib/*.test.mjs",
    "graphql:manifest": "node scripts/extract-graphql-documents.mjs --write-manifest",
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "node ./server.mjs"
  },
  "overrides": {
    "tar": "7.5.22",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "toml": "4.2.0",
    "vite": "$vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@remix-run/dev": "^2.15.0",
    "@remix-run/node": "^2.15.0",
    "@remix-run/react": "^2.15.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ajv": "^8.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3"
  }
}

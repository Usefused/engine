{
  "name": "@fused/runtime",
  "version": "0.1.0",
  "description": "Shared Fused Engine gRPC execution client",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./protocol": "./dist/src/engine.proto"
  },
  "files": ["dist/src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-protocol.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepack": "npm run build",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": { "@grpc/grpc-js": "1.14.6", "@grpc/proto-loader": "0.8.1" },
  "devDependencies": { "@types/node": "25.9.1", "typescript": "6.0.3" }
}

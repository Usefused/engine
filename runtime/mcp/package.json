{
  "name": "fused-mcp-shared-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared MCP runtime exposing exactly search_docs and execute for Engine-managed MCP apps.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild dist/server.js --bundle --platform=node --format=cjs --outfile=dist/bundle.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}

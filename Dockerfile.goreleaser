# syntax=docker/dockerfile:1

FROM node:24-alpine AS execution-compiler-builder

WORKDIR /app/runtime/execution
RUN apk upgrade --no-cache
COPY runtime/execution/package.json runtime/execution/package-lock.json ./
RUN npm ci
COPY runtime/execution/tsconfig.json ./
COPY runtime/execution/src ./src
RUN npm run build && npm prune --omit=dev

# The optional pinned Python agent runtime requires glibc.
FROM node:24-bookworm-slim AS engine-runtime

WORKDIR /app

# Node remains part of the runtime because MCP sessions execute in isolated
# processes. GoReleaser builds the bundled MCP runtime before compiling the Go
# binary, so containers never install dependencies into tenant storage.
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates gosu nats-server tini && rm -rf /var/lib/apt/lists/*

# GoReleaser copies the selected binary to the root context. Headless release
# images pass ENGINE_BINARY=fused-engine-headless but keep /app/fused-engine as
# the in-container command name.
ARG ENGINE_BINARY=fused-engine
COPY ${ENGINE_BINARY} /app/fused-engine
# GoReleaser places the Linux worker beside either Engine variant in each
# Docker build context, preserving one worker path for both runtime images.
COPY fused-execution-worker /app/fused-execution-worker
COPY --from=execution-compiler-builder /app/runtime/execution /app/runtime/execution
COPY engine.yaml /app/engine.yaml
COPY entrypoint.sh /app/entrypoint.sh

RUN groupadd --system fused && useradd --system --create-home --gid fused fused && \
    mkdir -p /app/data/sandboxes && \
    chown -R fused:fused /app

# The unprivileged process needs a writable home and persistent optional-agent cache.
ENV HOME=/home/fused XDG_CACHE_HOME=/app/data/cache

EXPOSE 8081 50051

ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
CMD ["/app/fused-engine", "start"]

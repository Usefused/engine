# syntax=docker/dockerfile:1

# Thin wrapper over the published Fused Engine OCI image for Vercel Containers.
# Engine honors Vercel's injected $PORT automatically via config.ResolveServerConfig.
ARG FUSED_ENGINE_VERSION=latest
FROM ghcr.io/usefused/engine:${FUSED_ENGINE_VERSION}

ENV FUSED_ENGINE_ENVIRONMENT=production \
    FUSED_DATABASE_MAX_CONN_IDLE_TIME=2m
